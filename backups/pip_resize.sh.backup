#!/bin/bash
# filepath: ~/.config/hypr/scripts/pip_resize.sh

# CUSTOM PiP Resize Script - Optimized for Vivaldi Meet
# Cycles through sizes: 15% → 20% → 25% → 30% → 35% → 15% (infinite loop)

# State file location (moved to cache/)
STATE_FILE="$HOME/.config/hypr/cache/.pip_size"
mkdir -p "$(dirname "$STATE_FILE")"  # Ensure cache directory exists

# Function to find PiP window with relaxed size constraints
find_pip_window() {
    # Try 1: Exact Meet PiP pattern (strict)
    local addr=$(hyprctl clients -j | jq -r '
        .[] | 
        select(
            (.class == "vivaldi-stable") and
            (.title | test("^Meet - [a-z]{3}-[a-z]{4}-[a-z]{3}$")) and
            .floating == true
        ) | 
        .address
    ' | head -n 1)
    
    if [ -n "$addr" ]; then echo "$addr"; return 0; fi
    
    # Try 2: Any Meet window that's floating (relaxed size)
    addr=$(hyprctl clients -j | jq -r '
        .[] | 
        select(
            (.class == "vivaldi-stable") and
            (.title | startswith("Meet -")) and
            .floating == true
        ) | 
        .address
    ' | head -n 1)
    
    if [ -n "$addr" ]; then echo "$addr"; return 0; fi
    
    # Try 3: Generic PiP title pattern
    addr=$(hyprctl clients -j | jq -r '
        .[] | 
        select(.title | test("Picture-in-Picture|Picture in Picture|PiP"; "i")) | 
        .address
    ' | head -n 1)
    
    if [ -n "$addr" ]; then echo "$addr"; return 0; fi
    
    # Try 4: Any small floating Vivaldi window (emergency fallback)
    addr=$(hyprctl clients -j | jq -r '
        .[] | 
        select(
            (.class == "vivaldi-stable") and
            .floating == true and
            (.size[0] < 1000 and .size[1] < 800)
        ) | 
        .address
    ' | head -n 1)
    
    echo "$addr"
}

# Find PiP window
PIP_ADDR=$(find_pip_window)

if [ -z "$PIP_ADDR" ]; then
    notify-send "❌ PiP Not Found" "No Meet PiP window detected\nMake sure window is floating" -t 2500 -u critical
    # Reset state on error so next resize starts fresh
    echo "20" > "$STATE_FILE"
    exit 1
fi

# Read current size state with default
CURRENT_SIZE=$(cat "$STATE_FILE" 2>/dev/null || echo "15")

# Validate CURRENT_SIZE is a number, reset if corrupted
if ! [[ "$CURRENT_SIZE" =~ ^[0-9]+$ ]]; then
    CURRENT_SIZE=15
fi

# Screen dimensions from active monitor
SCREEN_WIDTH=$(hyprctl monitors -j | jq -r '.[0].width')
SCREEN_HEIGHT=$(hyprctl monitors -j | jq -r '.[0].height')

# Cycle through sizes with wrap-around (infinite loop)
case "$CURRENT_SIZE" in
    15) NEXT_SIZE=20 ;;
    20) NEXT_SIZE=25 ;;
    25) NEXT_SIZE=30 ;;
    30) NEXT_SIZE=35 ;;
    35) NEXT_SIZE=15 ;;  # ← CYCLE BACK TO START
    *) NEXT_SIZE=20 ;;   # Default fallback
esac

# Calculate new dimensions
NEW_WIDTH=$((SCREEN_WIDTH * NEXT_SIZE / 100))
NEW_HEIGHT=$((SCREEN_HEIGHT * NEXT_SIZE / 100))

# Apply minimum size constraints (prevent too small)
MIN_WIDTH=300
MIN_HEIGHT=200
if [ $NEW_WIDTH -lt $MIN_WIDTH ]; then NEW_WIDTH=$MIN_WIDTH; fi
if [ $NEW_HEIGHT -lt $MIN_HEIGHT ]; then NEW_HEIGHT=$MIN_HEIGHT; fi

# Resize window
hyprctl dispatch resizewindowpixel exact ${NEW_WIDTH} ${NEW_HEIGHT},address:${PIP_ADDR}

# Small delay to let resize complete
sleep 0.05

# Keep it in bottom-right corner with margin
MARGIN=20
X=$((SCREEN_WIDTH - NEW_WIDTH - MARGIN))
Y=$((SCREEN_HEIGHT - NEW_HEIGHT - MARGIN))
hyprctl dispatch movewindowpixel exact ${X} ${Y},address:${PIP_ADDR}

# Ensure it stays pinned and floating
hyprctl dispatch pin address:${PIP_ADDR}

# Save state for next cycle
echo "$NEXT_SIZE" > "$STATE_FILE"

# Show notification with cycle info
if [ "$NEXT_SIZE" = "15" ]; then
    notify-send "🔄 PiP Resized" "${NEXT_SIZE}% (Cycled back to smallest)\n${NEW_WIDTH}x${NEW_HEIGHT}px" -t 1500
else
    notify-send "✅ PiP Resized" "${NEXT_SIZE}% of screen\n${NEW_WIDTH}x${NEW_HEIGHT}px" -t 1500
fi

exit 0
